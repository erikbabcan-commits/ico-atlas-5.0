APP_NAME="WhoIsWho SK"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_WHOISWHO_LEVEL=info

# PostgreSQL (persistencia: snapshots + nodes/edges)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=whoiswho
DB_USERNAME=whoiswho
DB_PASSWORD=secret

SESSION_DRIVER=array
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# WhoIsWho SK
# Service API key pre Bearer auth (generuj: openssl rand -hex 32)
WHOISWHO_API_KEY=
WHOISWHO_CACHE_TTL_HOURS=24
WHOISWHO_HTTP_TIMEOUT=12

# Zdroje dát
WHOISWHO_RPO_BASE_URL=https://api.statistics.sk/rpo/v1
WHOISWHO_RPO_ENABLED=true
WHOISWHO_RUZ_BASE_URL=https://www.registeruz.sk/cruz-public/api
WHOISWHO_RUZ_ENABLED=true
WHOISWHO_RPVS_BASE_URL=https://rpvs.gov.sk/opendatav2
WHOISWHO_RPVS_ENABLED=true

# Legacy ORSR HTML scrape — P3 fallback, DEFAULTNE VYPNUTÝ
WHOISWHO_ORSR_SCRAPE_ENABLED=false
WHOISWHO_ORSR_BASE_URL=https://www.orsr.sk
WHOISWHO_ORSR_SEARCH_URL=https://www.orsr.sk/hladaj_ico.asp
WHOISWHO_ORSR_TTL_HOURS=24
WHOISWHO_ORSR_MIN_INTERVAL=1
WHOISWHO_ORSR_MAX_RETRIES=3

MAIL_MAILER=log
